# Groq Cloud API Configuration (Primary Ultra-Fast Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter API Key for fallback LLM inference
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary & Fallback Models
PRIMARY_MODEL=recursive/flint-v1.0:free
FALLBACK_MODELS=cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free

# Admin Key for protected endpoints (/api/admin/gaps, /api/leads)
ADMIN_API_KEY=placidway_admin_key_2026

# Supabase Cloud PostgreSQL Configuration (Required for Vercel persistent storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Data Storage
DATA_DIR=data
DB_PATH=data/placidway_bot.db
VECTOR_INDEX_PATH=data/vector_index.json

# Retrieval Settings
SIMILARITY_THRESHOLD=0.20
TOP_K_CHUNKS=4
