{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?path=$1"
    },
    {
      "source": "/healthz",
      "destination": "/api/index?path=healthz"
    },
    {
      "source": "/docs",
      "destination": "/api/index?path=docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index?path=openapi.json"
    }
  ]
}
